<Window x:Class="N_m3u8DL_RE_GUI.Views.FileConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="같은 파일이 이미 있습니다"
        Width="520" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1C1C22"
        AutomationProperties.Name="Existing File Conflict">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#5865F2"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4350D8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0B8"/>
        <SolidColorBrush x:Key="BorderBrushCustom" Color="#66667C"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="저장 폴더에 같은 이름의 파일이 이미 있습니다."
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Grid.Row="1" x:Name="Text_ExistingFile"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="덮어쓰면 기존 파일을 삭제하고 새로 다운로드합니다. 이름 바꾸기를 선택하면 사용 가능한 새 파일명을 자동으로 만듭니다."/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Button_CancelConflict" Content="취소" IsCancel="True"
                    AutomationProperties.Name="취소"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button x:Name="Button_RenameConflict" Content="이름 바꾸기"
                    AutomationProperties.Name="이름 바꾸기"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Rename_Click"/>
            <Button x:Name="Button_OverwriteConflict" Content="덮어쓰기"
                    AutomationProperties.Name="덮어쓰기"
                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Overwrite_Click"/>
        </StackPanel>
    </Grid>
</Window>