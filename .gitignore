# --- UVD public-repository hardening ---
# Runtime binaries are release artifacts, not source-controlled blobs.
/ffmpeg.exe
/yt-dlp.exe
/N_m3u8DL-RE.exe
*.exe
*.dll

# Generated extension suite marker.
/UVD-Source-Capture/suite-version.json

# Native Messaging manifests are machine- and extension-ID-specific.
com.uvd.bridge.json
**/com.uvd.bridge.json

# User state, browser profiles, queues and downloads.
Downloads/
downloads/
Logs/
NativeInbox/
.webview2-profile/
.nre-tmp/
*.mp4
*.mkv
*.webm
*.mov
*.ts

# Local secrets / environment overrides.
.env
.env.*
!.env.example
*.pem
*.p12
*.snk
secrets*.json
credentials*.json
